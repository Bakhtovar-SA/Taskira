# Taskira server — секреты только через env, .env в .gitignore
DATABASE_URL=postgresql://taskira:taskira@localhost:5432/taskira
# Минимум 32 символа; сгенерируйте: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h
PORT=8080
HOST=0.0.0.0
# Разрешённые источники CORS через запятую. «*» поддерживается, но в сети компании
# указывайте точный адрес фронтенда.
CORS_ORIGIN=http://localhost:5173
# Первый администратор создаётся при пустой таблице users
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Администратор
# Департамент по умолчанию (find-or-create при сиде; миграция 007)
DEFAULT_DEPARTMENT=Общий отдел
# Интеграционные тесты (vitest). По умолчанию — схема taskira_test внутри dev-БД
# (отдельная БД и права CREATEDB не нужны, dev-схема public не трогается).
# В CI укажите отдельную БД, напр. postgresql://postgres:postgres@localhost:5432/taskira_test
# DATABASE_URL_TEST=postgresql://taskira:taskira@localhost:5432/taskira?options=-csearch_path%3Dtaskira_test%2Cpublic
# Проект и workflow создаются при пустой таблице projects (идемпотентно)
PROJECT_KEY=CORP
PROJECT_NAME=Корпоративные задачи
