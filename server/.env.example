# Taskira server — секреты только через env, .env в .gitignore
DATABASE_URL=postgresql://taskira:taskira@localhost:5432/taskira
# Минимум 32 символа; сгенерируйте: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Absolute session lifetime and active-cookie rotation, in seconds.
SESSION_TTL_SECONDS=28800
SESSION_ROTATE_AFTER_SECONDS=3600
PORT=8080
HOST=0.0.0.0
# Разрешённые источники CORS через запятую. «*» поддерживается, но в сети компании
# указывайте точный адрес фронтенда. Dev-сервер Vite — на :3000 (strictPort).
CORS_ORIGIN=http://localhost:3000
# HttpOnly-cookie: production по умолчанию добавляет Secure. Для прямого HTTP
# в закрытом контуре явно false; за HTTPS reverse proxy оставьте true.
SESSION_COOKIE_SECURE=false
# Доверять заголовкам X-Forwarded-* (опция Fastify trustProxy). За nginx/LB
# ОБЯЗАТЕЛЬНО, иначе req.ip = адрес прокси: rate-limit логина считает всех как
# один IP, в audit-логе тоже адрес прокси. Пусто/false — прямой доступ (дефолт);
# true — единственный доверенный прокси в приватной сети; либо список IP/CIDR
# через запятую — доверять только им (напр. 127.0.0.1,10.0.0.0/8).
TRUST_PROXY=false
# Первый администратор создаётся при пустой таблице users.
# В режиме AUTH_MODE=ldap это break-glass локальный вход (пароль работает,
# когда LDAP недоступен) — держите пароль сильным, см. LDAP_MIGRATION.md D2.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Администратор
# Local/break-glass password: 14–128 characters of any kind (no character-group
# rules), not a common password, no username, no product/organization/team name
# (SEC-PWD-02). Lock a known account after failed logins (also counts wrong
# current passwords on password change).
ACCOUNT_LOCK_MAX_FAILURES=5
ACCOUNT_LOCK_SECONDS=900
# Extra context words forbidden in passwords, comma-separated (organization name, codenames).
# PASSWORD_CONTEXT_WORDS=
# Lifetime of an admin-issued temporary password, hours (1–168), SEC-PWD-01.
# PASSWORD_RESET_TTL_HOURS=24

# --- Аутентификация -------------------------------------------------------------
# local (по умолчанию) — только пароль. ldap — LDAP/AD + break-glass admin выше.
# Полное описание переменных и подключение к реальному AD — LDAP_SETUP.md.
# Локальный тестовый LDAP: server/test/ldap/README.md
AUTH_MODE=local
# LDAP_URL=ldap://localhost:389
# LDAP_BIND_DN=cn=admin,dc=taskira,dc=test
# LDAP_BIND_PASSWORD=
# LDAP_USER_BASE_DN=ou=people,dc=taskira,dc=test
# LDAP_USER_FILTER=(uid={username})              # AD: (sAMAccountName={username})
# LDAP_USER_DN_TEMPLATE=                          # только для прямого bind без сервис-аккаунта
# LDAP_GROUP_MEMBERSHIP=memberOf                  # AD: memberOf; тестовый OpenLDAP: search
# LDAP_GROUP_BASE_DN=ou=groups,dc=taskira,dc=test # нужен при LDAP_GROUP_MEMBERSHIP=search
# LDAP_ADMIN_GROUP_DN=cn=taskira-admins,ou=groups,dc=taskira,dc=test
# LDAP_ATTR_LOGIN=sAMAccountName                  # тестовый OpenLDAP: uid
# LDAP_ATTR_NAME=displayName                      # тестовый OpenLDAP: cn
# Стандартный givenName читается отдельно для приветствия; LDAP_ATTR_NAME остаётся полным именем.
# LDAP_ATTR_MAIL=mail
# LDAP_ATTR_TITLE=title                           # должность — синкается в users.job_role при каждом логине
# LDAP_ATTR_PHONE=telephoneNumber                 # телефон — синкается в users.phone при каждом логине
# LDAP_STARTTLS=false
# LDAP_TLS_CA_FILE=
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# LDAP_TIMEOUT_MS=5000
# Фоновый ресинк членства в департаментах из LDAP-групп (до сих пор — только
# JIT при логине и ручной POST /api/ldap/resync). Требует LDAP_BIND_DN
# (сервис-аккаунт) — без него джоб молча не стартует.
# LDAP_RESYNC_ENABLED=true
# LDAP_RESYNC_INTERVAL_MS=21600000               # раз в 6 часов

# --- Вложения к задачам (файлы) ------------------------------------------------
# FILES_MIGRATION.md. local (по умолчанию) — файлы на диске; s3 — S3-совместимое
# хранилище (MinIO/on-prem), правильный вариант для нескольких серверов.
# Полное описание переменных и подключение к реальному S3 — STORAGE_SETUP.md.
# Локальный тестовый MinIO: server/docker-compose.storage.yml
STORAGE_DRIVER=local
# STORAGE_DIR=                                   # драйвер local: каталог для объектов; деф. server/var/attachments
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_BUCKET=taskira-attachments
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=true               # true для MinIO
# ATTACH_MAX_BYTES=26214400                      # 25 MiB на файл
# ATTACH_MAX_PER_ISSUE=50
# ATTACH_MAX_FILENAME=200
# ATTACH_BLOCK_EXT=                              # переопределить список запрещённых расширений (через запятую/пробел)
# AVATAR_MAX_BYTES=3145728                        # 3 MiB на аватарку (тот же STORAGE_DRIVER, свой потолок)

# --- Уведомления --------------------------------------------------------------
# NOTIFICATIONS_MIGRATION.md. In-app-уведомления работают всегда. Email — только
# при NOTIFY_EMAIL_ENABLED=true (тогда обязательны SMTP_HOST/PORT/FROM и APP_BASE_URL).
# Полное описание и подключение к корпоративному SMTP — NOTIFICATIONS_SETUP.md.
# Локальный тестовый SMTP: server/docker-compose.mail.yml (Mailpit)
NOTIFY_EMAIL_ENABLED=false
# NOTIFY_WORKER_ENABLED=true                     # стартовать фоновый луп в этом процессе
# NOTIFY_WORKER_INTERVAL_MS=15000
# NOTIFY_EMAIL_MAX_TRIES=4
# NOTIFY_DIGEST_WINDOW_MS=3600000                # окно дайджеста (notify_prefs.email=daily)
# APP_BASE_URL=http://localhost:3000             # база для ссылок в письмах (обязательна при email)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=                                     # пусто — анонимный релей в контуре
# SMTP_PASS=
# SMTP_SECURE=false                             # true — implicit TLS (порт 465)
# SMTP_FROM=Taskira <noreply@taskira.test>
# SMTP_TLS_REJECT_UNAUTHORIZED=true              # false — принять самоподписанный сертификат relay (закрытый контур без доверенного CA)

# --- Жизненный цикл задач и обслуживание --------------------------------------
# Миграция 016. Закрытая задача (статус категории done) получает done_at, а через
# ARCHIVE_AFTER_DAYS уходит в архив: пропадает с доски и из «Списка задач», но
# остаётся в БД, открывается по прямой ссылке, ищется (?archived=all) и входит
# в отчёты. Архив — не удаление; он нужен, чтобы активный набор проекта не рос
# бесконечно. Возврат задачи в работу выводит её из архива автоматически.
# MAINTENANCE_ENABLED=true                       # луп обслуживания в этом процессе; при нескольких инстансах каждый тик
#                                                # исполняет один процесс (advisory-лок), остальные пропускают тик
# MAINTENANCE_INTERVAL_MS=3600000                # как часто проходить (по умолчанию раз в час)
# MAINTENANCE_START_DELAY_MS=300000              # первый проход — через столько после старта процесса (деф. 5 мин): рестарт
#                                                # или деплой в час пик ничего не запускает сразу; sweep/LDAP — после неё (+15 с, +30 с)
# MAINTENANCE_BATCH_SIZE=1000                    # строк в одной пачке архивации/уборки аудита (блокировка — на время пачки)
# MAINTENANCE_BATCH_PAUSE_MS=50                  # пауза между пачками
# MAINTENANCE_MAX_PER_RUN=50000                  # потолок строк каждого вида за проход; остаток — следующими проходами
# ARCHIVE_AFTER_DAYS=30                          # через сколько дней после закрытия задача уходит в архив
# AUDIT_RETENTION_DAYS=365                       # хранение audit_log; 0 — не удалять никогда

# Сборщик осиротевших объектов Storage: удаление задачи/проекта снимает строки
# attachments, но не сами файлы — их подчищает этот отдельный (более редкий) луп.
# БД — источник истины: объект без строки attachments считается мусором старше
# STORAGE_SWEEP_GRACE_MS (защита от гонки с загрузкой, которая пишет файл раньше
# своей строки в БД).
# STORAGE_SWEEP_ENABLED=true                     # тот же принцип «включать на одном инстансе»
# STORAGE_SWEEP_INTERVAL_MS=86400000             # как часто проходить (по умолчанию раз в сутки)
# STORAGE_SWEEP_GRACE_MS=86400000                # минимальный возраст объекта-кандидата на удаление

# --- Нагрузка и лимиты --------------------------------------------------------
# PG_POOL_MAX=10                                 # размер пула соединений к Postgres
# ASSIGNEES_CACHE_TTL_MS=45000                   # кэш списка исполнителей фильтра доски на процесс, мс (0 — выключить)
# PG_POOL_IDLE_TIMEOUT_MS=0                      # 0 — держать соединения открытыми (нет задержки первого
#                                                # запроса после паузы); при нескольких процессах сервера
#                                                # занято процессов × PG_POOL_MAX соединений
# RATE_LIMIT_ENABLED=true                        # общий лимит запросов; тесты выключают явно
# RATE_LIMIT_MAX=600                             # запросов в окно на пользователя (ключ — id, не IP:
#                                                # за корпоративным NAT у всех один адрес)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_LOGIN_MAX=10                        # попыток входа с одного IP
# RATE_LIMIT_LOGIN_WINDOW_MS=300000

# Команда по умолчанию (в коде — department; find-or-create при сиде; миграция 007). Переименовать можно в интерфейсе.
DEFAULT_DEPARTMENT=Общий отдел
# Интеграционные тесты (vitest) идут в ОТДЕЛЬНОЙ БД taskira_test (TEST-01): создаётся при отсутствии,
# нужно право CREATEDB у роли (ALTER ROLE taskira CREATEDB; один раз) либо создайте БД вручную.
# Схемный режим (options=-csearch_path=…) не поддерживается.
# DATABASE_URL_TEST=postgresql://taskira:taskira@localhost:5432/taskira_test
# Проект и workflow создаются при пустой таблице projects (идемпотентно)
PROJECT_KEY=CORP
PROJECT_NAME=Корпоративные задачи

# Строка instance (ТЗ 4.1, docs/adr/0009-database-per-tenant.md) — сеется при пустой таблице
# instance (идемпотентно), как и проект выше.
INSTANCE_NAME=Taskira (dev)
INSTANCE_PLAN=default

# Due reminders run independently of SMTP. Install-wide clock, not browser time.
DUE_REMINDER_ENABLED=true
DUE_REMINDER_TIMEZONE=Asia/Dushanbe
DUE_REMINDER_HOUR=9

# Webhooks are opt-in. Empty allowed targets means every destination is blocked.
# Targets: exact hostname, *.corp.local (subdomains only), IPv4/IPv6 or CIDR.
# Private networks can be allowed explicitly; loopback/link-local/multicast and IPv6 transition ranges stay blocked.
WEBHOOKS_ENABLED=false
WEBHOOK_ALLOWED_TARGETS=
# Additional denied CIDRs. Compose always adds TASKIRA_NETWORK_CIDR to this list.
WEBHOOK_DENY_CIDRS=
WEBHOOK_ALLOW_HTTP=false
# Required when enabled: 32 random bytes as 64 hex characters or canonical base64.
# Every WEBHOOK_* setting is validated at startup even when disabled; leave unused values empty.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key separate from JWT/backup keys. Changing it requires resetting subscription secrets.
WEBHOOK_SECRET_KEY=
WEBHOOK_POLL_MS=2000
WEBHOOK_LOG_RETENTION_DAYS=30

# Recurring issues: one transaction per rule, at most 20 rules per tick.
RECURRING_ENABLED=true
RECURRING_POLL_MS=60000
