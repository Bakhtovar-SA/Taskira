{
  "name": "taskira-server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Taskira API: Fastify + PostgreSQL + JWT. Права проверяются только здесь.",
  "scripts": {
    "dev": "cross-env CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=250 tsx watch src/index.ts",
    "dev:native": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ldap": "vitest run test/access.ldap.test.ts",
    "test:storage": "vitest run test/access.attachments.test.ts test/storage.s3.test.ts",
    "test:mail": "vitest run test/notifier.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "ldapts": "^9.0.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "cross-env": "^10.1.0",
    "ldapjs": "^3.0.7",
    "mailparser": "^3.9.23",
    "smtp-server": "^3.19.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
