# Taskira backup — конфиг (скопируйте в backup.env, он в .gitignore).

# Строка подключения к БД. Для прода пароль лучше держать в ~/.pgpass /
# PGPASSFILE и убрать его отсюда (иначе виден в списке процессов).
DATABASE_URL=postgresql://taskira:taskira@localhost:5432/taskira

# Каталог для снимков (по умолчанию <repo>/backups). На сервере — вне репозитория,
# на отдельном томе.
# BACKUP_DIR=/var/backups/taskira

# Сроки хранения (дни): ежедневные снимки и еженедельные копии.
RETENTION_DAYS=14
WEEKLY_RETENTION_DAYS=56

# Пути к утилитам, если не в PATH. Значения с пробелами — в кавычках.
# Linux:   PGDUMP=/usr/bin/pg_dump
#          PGRESTORE=/usr/bin/pg_restore
# Windows: PGDUMP="C:/Program Files/PostgreSQL/18/bin/pg_dump.exe"
#          PGRESTORE="C:/Program Files/PostgreSQL/18/bin/pg_restore.exe"
