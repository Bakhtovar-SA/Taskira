# Корневой .env — читается ДВУМЯ независимыми вещами:
#
#   1) `npm run dev` (Vite, локальная разработка без Docker) — смотрит только
#      на VITE_API_URL. Остальные переменные ниже он игнорирует.
#   2) `docker compose up` (DOCKER_SETUP.md) — читает ВСЕ переменные ниже для
#      подстановки в docker-compose.yml. server/.env — отдельный файл, для
#      локального `cd server && npm run dev`; в контейнере не используется,
#      конфигурация приходит через environment: в docker-compose.yml.

# --- Локальная разработка (npm run dev) -----------------------------------
# VITE_API_URL=http://localhost:8080

# --- docker-compose ---------------------------------------------------------
# Порт, на котором PostgreSQL слушает ВНУТРИ docker-сети — наружу не публикуется.
POSTGRES_USER=taskira
POSTGRES_PASSWORD=
POSTGRES_DB=taskira

# ≥32 символа, сгенерировать: openssl rand -base64 32
JWT_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Порты на ХОСТЕ (слева от :) — какими Taskira будет видна снаружи контейнеров.
SERVER_PORT=8080
CLIENT_PORT=8081

# Совпадать они ДОЛЖНЫ: CORS_ORIGIN — что реально придёт в заголовке Origin
# от браузера; VITE_API_URL печётся в сборку клиента (см. Dockerfile) — куда
# именно ЭТОТ браузер должен стучаться за API. localhost имеет смысл только
# для локальной проверки; на реальном сервере — публичные адреса/домены.
CORS_ORIGIN=http://localhost:8081
VITE_API_URL=http://localhost:8080
