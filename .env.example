# Корневой .env — читается ДВУМЯ независимыми вещами:
#
#   1) `npm run dev` (Vite, локальная разработка без Docker) — смотрит только
#      на VITE_API_URL. Остальные переменные ниже он игнорирует.
#   2) `docker compose up` (DOCKER_SETUP.md) — читает ВСЕ переменные ниже для
#      подстановки в docker-compose.yml. server/.env — отдельный файл, для
#      локального `cd server && npm run dev`; в контейнере не используется,
#      конфигурация приходит через environment: в docker-compose.yml.

# --- Локальная разработка (npm run dev) -----------------------------------
# VITE_API_URL=http://localhost:8080

# --- docker-compose ---------------------------------------------------------
# Отображается в health endpoint и меню пользователя; для разработки — dev.
TASKIRA_VERSION=dev
# Порт, на котором PostgreSQL слушает ВНУТРИ docker-сети — наружу не публикуется.
POSTGRES_USER=taskira
# docker-compose.yml подставляет это без URL-экранирования в DATABASE_URL
# (postgresql://user:PASSWORD@host/db) — символы @ / : # % в пароле разберутся
# неверно, и server не подключится к БД без явной причины в логе. Генератор
# с безопасным алфавитом: openssl rand -hex 24 (НЕ -base64 — тот даёт +/=).
POSTGRES_PASSWORD=
POSTGRES_DB=taskira

# ≥32 символа, сгенерировать: openssl rand -base64 32
JWT_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Порты на ХОСТЕ (слева от :) — какими Taskira будет видна снаружи контейнеров.
CLIENT_PORT=8081

# CORS_ORIGIN — origin клиента, который реально придёт от браузера.
# VITE_API_URL обычно оставляют пустым: nginx клиента проксирует /api по
# внутренней compose-сети. Заполняйте его только для legacy-схемы, где API
# опубликован на отдельном origin; значение печётся в клиентский образ.
CORS_ORIGIN=http://localhost:8081
# The bundled nginx is the only proxy hop in the default compose topology.
TRUST_PROXY=true
VITE_API_URL=
# false — прямой HTTP из compose; true — только если перед ним настроен HTTPS.
SESSION_COOKIE_SECURE=false
