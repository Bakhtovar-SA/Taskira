# Корневой .env — читается ДВУМЯ независимыми вещами:
#
#   1) `npm run dev` (Vite, локальная разработка без Docker) — смотрит только
#      на VITE_API_URL. Остальные переменные ниже он игнорирует.
#   2) `docker compose up` (DOCKER_SETUP.md) — читает ВСЕ переменные ниже для
#      подстановки в docker-compose.yml. server/.env — отдельный файл, для
#      локального `cd server && npm run dev`; в контейнере не используется,
#      конфигурация приходит через environment: в docker-compose.yml.

# --- Локальная разработка (npm run dev) -----------------------------------
# VITE_API_URL=http://localhost:8080

# --- docker-compose ---------------------------------------------------------
# Отображается в health endpoint и меню пользователя; для разработки — dev.
TASKIRA_VERSION=dev
# Порт, на котором PostgreSQL слушает ВНУТРИ docker-сети — наружу не публикуется.
POSTGRES_USER=taskira
# docker-compose.yml подставляет это без URL-экранирования в DATABASE_URL
# (postgresql://user:PASSWORD@host/db) — символы @ / : # % в пароле разберутся
# неверно, и server не подключится к БД без явной причины в логе. Генератор
# с безопасным алфавитом: openssl rand -hex 24 (НЕ -base64 — тот даёт +/=).
POSTGRES_PASSWORD=
POSTGRES_DB=taskira

# ≥32 символа, сгенерировать: openssl rand -base64 32
JWT_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Название этой инсталляции (таблица instance, ТЗ 4.1, docs/adr/0009-database-per-tenant.md —
# database-per-tenant: одна инсталляция = один процесс = одна строка instance). Задаётся один
# раз при провижининге — сеется вместе с админом/проектом при первом старте, редактировать
# после старта пока негде (нет route; появится вместе с ТЗ 4.3, лицензией).
INSTANCE_NAME=Taskira
INSTANCE_PLAN=default

# Local and break-glass passwords: 14-128 characters of any kind (no character
# group rules), not a common password, no username, no product/organization/team
# name (SEC-PWD-02). The password must not be a known default.
SESSION_TTL_SECONDS=28800
SESSION_ROTATE_AFTER_SECONDS=3600
ACCOUNT_LOCK_MAX_FAILURES=5
ACCOUNT_LOCK_SECONDS=900
# Extra words forbidden in passwords, comma-separated (organization name, codenames).
PASSWORD_CONTEXT_WORDS=
# Lifetime of an admin-issued temporary password, hours (1-168), SEC-PWD-01.
PASSWORD_RESET_TTL_HOURS=24

# Порты на ХОСТЕ (слева от :) — какими Taskira будет видна снаружи контейнеров.
CLIENT_PORT=8081

# CORS_ORIGIN — origin клиента, который реально придёт от браузера.
# VITE_API_URL обычно оставляют пустым: nginx клиента проксирует /api по
# внутренней compose-сети. Заполняйте его только для legacy-схемы, где API
# опубликован на отдельном origin; значение печётся в клиентский образ.
CORS_ORIGIN=http://localhost:8081
# Compose uses this CIDR for both network IPAM and the trusted nginx hop.
# Choose a free subnet when running several installations on one host.
TASKIRA_NETWORK_CIDR=172.30.0.0/24
VITE_API_URL=
ATTACH_MAX_BYTES=26214400
ATTACH_MAX_PER_ISSUE=50
# false — прямой HTTP из compose; true — только если перед ним настроен HTTPS.
SESSION_COOKIE_SECURE=false

STORAGE_DRIVER=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# Due reminders run independently of SMTP. Install-wide clock, not browser time.
DUE_REMINDER_ENABLED=true
DUE_REMINDER_TIMEZONE=Asia/Dushanbe
DUE_REMINDER_HOUR=9

# Webhooks (Track L): disabled until explicitly configured.
# All settings are validated even while disabled; keep unused values empty.
WEBHOOKS_ENABLED=false
# Exact host, *.corp.local (subdomains only), IP or CIDR. Empty means deny all.
# A permitted name grants every non-denied IP returned by its DNS, on any port.
WEBHOOK_ALLOWED_TARGETS=
# Extra denied ranges; Compose always adds TASKIRA_NETWORK_CIDR.
WEBHOOK_DENY_CIDRS=
WEBHOOK_ALLOW_HTTP=false
# Required when enabled: 32 random bytes, 64 hex characters or canonical base64.
# Generate: openssl rand -hex 32. Keep separate from JWT/backup encryption keys.
# Changing this key requires resetting subscription secrets.
WEBHOOK_SECRET_KEY=
WEBHOOK_POLL_MS=2000
WEBHOOK_LOG_RETENTION_DAYS=30

# Background loops and recurring calendar rules (Track L).
MAINTENANCE_ENABLED=true
RECURRING_ENABLED=true
RECURRING_POLL_MS=60000
