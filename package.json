{
  "name": "taskira",
  "private": true,
  "type": "module",
  "imports": {
    "#secure-jsx/*": "./src/secure-jsx/*.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "permissions:generate": "node scripts/generate-permissions.mjs",
    "permissions:check": "node scripts/generate-permissions.mjs --check",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:check": "tsx scripts/generate-docs.ts --check",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "zod": "^3.25.76"
  }
}
