{
  "name": "taskira",
  "private": true,
  "type": "module",
  "imports": {
    "#secure-jsx/*": "./src/secure-jsx/*.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --quiet",
    "lint:all": "eslint src",
    "permissions:generate": "node scripts/generate-permissions.mjs",
    "permissions:check": "node scripts/generate-permissions.mjs --check",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:check": "node scripts/generate-motion-tokens.mjs --check && tsx scripts/generate-docs.ts --check && node scripts/motion-map.mjs --self-test && node scripts/motion-map.mjs --check && node scripts/check-repo-weight.mjs",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "contrast:check": "node scripts/check-contrast.mjs",
    "colors:check": "node scripts/check-raw-colors.mjs",
    "motion:check": "node scripts/check-motion.mjs",
    "motion:map": "node scripts/motion-map.mjs",
    "antilist:check": "node scripts/check-antilist.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "repo:check": "node scripts/check-repo-weight.mjs",
    "perf:rerenders": "vitest run --config vitest.perf.config.ts",
    "csp:spike": "node scripts/csp-spike/run.mjs",
    "motion:spike": "node scripts/motion-spike/run.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:ui:production": "npm run build && playwright test --config playwright.production.config.ts",
    "perf:motion": "node scripts/perf-motion/run.mjs",
    "motion:tokens": "node scripts/generate-motion-tokens.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "motion": "13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  }
}
