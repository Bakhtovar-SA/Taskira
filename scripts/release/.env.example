# Taskira offline release settings. Copy to .env and fill every blank secret.
POSTGRES_USER=taskira
# Use a URL-safe value because it is interpolated into DATABASE_URL.
# Example generator: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=taskira

# At least 32 characters. Example: openssl rand -hex 48
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Address users enter in their browser, without a trailing slash.
# Use the server IP or internal DNS name, not localhost for remote users.
CORS_ORIGIN=
CLIENT_PORT=8081

# false is required for direct HTTP from this compose stack.
# Set true only when users open Taskira through an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false

# Attachment storage. The default keeps attachments in the Compose volume.
STORAGE_DRIVER=local
# For an existing offline MinIO/S3 endpoint set STORAGE_DRIVER=s3 and fill these.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
