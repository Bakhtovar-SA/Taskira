# Generated by scripts/build-release.sh for Taskira __VERSION__.
# All images are loaded from images/*.tar by install.sh; network pulls are disabled.
services:
  postgres:
    image: localhost/taskira-postgres:__VERSION__
    pull_policy: never
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-taskira}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is required in .env}
      POSTGRES_DB: ${POSTGRES_DB:-taskira}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-taskira} -d ${POSTGRES_DB:-taskira}"]
      interval: 5s
      timeout: 5s
      retries: 20

  server:
    image: localhost/taskira-server:__VERSION__
    pull_policy: never
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER:-taskira}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-taskira}
      JWT_SECRET: ${JWT_SECRET:?JWT_SECRET is required in .env}
      ADMIN_USERNAME: ${ADMIN_USERNAME:-admin}
      ADMIN_PASSWORD: ${ADMIN_PASSWORD:?ADMIN_PASSWORD is required in .env}
      ADMIN_NAME: ${ADMIN_NAME:-Administrator}
      CORS_ORIGIN: ${CORS_ORIGIN:?CORS_ORIGIN is required in .env}
      APP_BASE_URL: ${CORS_ORIGIN:?CORS_ORIGIN is required in .env}
      TRUST_PROXY: "true"
      SESSION_COOKIE_SECURE: ${SESSION_COOKIE_SECURE:-false}
      STORAGE_DIR: /app/var/attachments
    volumes:
      - attachments:/app/var/attachments
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://localhost:8080/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 15s

  client:
    image: localhost/taskira-client:__VERSION__
    pull_policy: never
    restart: unless-stopped
    depends_on:
      server:
        condition: service_healthy
    ports:
      - "${CLIENT_PORT:-8081}:80"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://localhost/healthz"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 5s

volumes:
  pgdata:
  attachments:
